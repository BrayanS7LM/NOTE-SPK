<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTE SPEAK"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/bungee_regular"
            android:layout_marginTop="80dp"
            android:contentDescription="Nombre de la aplicación"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginTop="40dp"/>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduce tu correo electrónico y contraseña para entrar"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"/>

        <!-- Correo -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="email@domain.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:importantForAccessibility="yes"
            android:contentDescription="Campo para ingresar el correo electrónico" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:importantForAccessibility="yes"
            android:contentDescription="Campo para ingresar la contraseña" />

        <!-- Botón principal: redondeado negro -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONTINUAR"
            android:contentDescription="Botón continuar. Iniciar sesión con correo y contraseña"
            android:layout_marginTop="20dp"
            android:paddingVertical="0dp"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            android:backgroundTint="#000000"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#80FFFFFF"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"/>

        <!-- Google button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONTINUAR CON GOOGLE"
            android:contentDescription="Botón continuar con Google"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:iconSize="24dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            app:cornerRadius="8dp"/>

        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:contentDescription="Crear una cuenta nueva"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al hacer clic en continuar, aceptas nuestros Términos de Servicio y nuestra Política de Privacidad"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Aviso de términos de servicio"/>

    </LinearLayout>
</ScrollView>